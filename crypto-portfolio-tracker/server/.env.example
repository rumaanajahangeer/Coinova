# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/crypto-tracker

# Auth (generate a long random string: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_EXPIRES=7d

# CoinGecko (the public API works without a key but is rate limited).
# For a free Demo key set COINGECKO_API_KEY and leave the rest as is.
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_KEY_HEADER=x-cg-demo-api-key
# For a paid Pro key use:
# COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
# COINGECKO_KEY_HEADER=x-cg-pro-api-key

# Ethereum JSON-RPC used to read wallet balances (read-only)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Background jobs (cron syntax)
ALERT_CRON=* * * * *
SNAPSHOT_CRON=0 * * * *
